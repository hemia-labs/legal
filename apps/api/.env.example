DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_LOGGING=false

# vault
# Con true, lee secretos desde HashiCorp Vault.
SECRETS_ENABLED=false

SECRETS_ENVIRONMENT=dev
SECRETS_CATEGORY=internal
SECRETS_OWNER=hemia
SECRETS_SYSTEM=legal
SECRETS_CACHE_ENABLED=true
SECRETS_CACHE_TTL_MS=60000

VAULT_BASE_URL=https://vault.hemia.com
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_AUTH_PATH=approle
VAULT_MOUNT_PREFIX=kv-
VAULT_TIMEOUT_MS=5000

PORT=3017
NODE_ENV=development
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

AMQP_URL=amqp://user:password@localhost:5672
EVENT_BUS_ENABLED=true
EVENT_BUS_SERVICE_NAME=hemia-legal
EVENT_BUS_PREFETCH=10
EVENT_BUS_OUTBOX_PUBLISHER_ENABLED=true
EVENT_LOG_FILE=events.log.jsonl

SSO_ISSUER=http://localhost:4000
SSO_CLIENT_ID=legal
SSO_CLIENT_SECRET=
SSO_AUDIENCE=legal-api
SSO_REDIRECT_URI=http://localhost:3017/auth/callback
SSO_FRONTEND_URL=http://localhost:5180
SSO_SCOPE=openid profile email offline_access legal.access legal.self.pending.read legal.self.acceptances.create legal.self.acceptances.read
SSO_COOKIE_NAME=legal_session
SSO_SESSION_TTL_SECONDS=600
SSO_COOKIE_SECURE=false

ACCESS_API_URL=http://localhost:3019
ACCESS_AUDIENCE=access-api
ACCESS_JWKS_URI=http://localhost:3019/.well-known/jwks.json
ACCESS_EVENT_SCOPE=events.consume
PRODUCT_CODE=legal

S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=300

# Internal target validation (dedicated Identity client; never commit secrets)
LEGAL_INTROSPECTION_URL=http://localhost:4000/oauth/introspect

# Separate consumer/service authorization; empty policies deny access.
LEGAL_PERSONAL_CLIENTS={}

# Technical evaluator/validator policies are stored in legal_service_clients.
# productCode -> issuerId/applicationId/termsDocumentId/privacyDocumentId/refundPolicyDocumentId
LEGAL_CHECKOUT_CONTRACTS={}

# External identity integrations: deployment egress policy and callback credentials

# OAuth client directory: Identity service client, audience identity-api,
# scope identity.oauth_clients.read. Never expose these credentials to the browser.
LEGAL_IDENTITY_CLIENTS_URL=http://localhost:4000/api/v1/oauth-clients

# One service identity per product/environment. Destinations configured in Identity.
LEGAL_SERVICE_CLIENT_ID=legal-service-dev
LEGAL_SERVICE_CLIENT_SECRET=

# Servicio autorizado para administrar Sistemas desde Console
LEGAL_CATALOG_CLIENT_ID=console-identity-admin

{
  "name": "api",
  "version": "0.2.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --config .prettierrc --write \"src/**/*.ts\" \"../../test/api/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "cd ../.. && apps/api/node_modules/.bin/eslint --config apps/api/eslint.config.mjs \"apps/api/{src,apps,libs}/**/*.ts\" \"test/api/**/*.ts\" --fix",
    "lint:check": "cd ../.. && apps/api/node_modules/.bin/eslint --config apps/api/eslint.config.mjs \"apps/api/{src,apps,libs}/**/*.ts\" \"test/api/**/*.ts\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "NODE_OPTIONS=--experimental-vm-modules node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ../../test/api/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs -d data-source.ts",
    "migration:generate": "bun run typeorm migration:generate src/database/migrations/Migration",
    "migration:run": "bun run typeorm migration:run",
    "migration:revert": "bun run typeorm migration:revert",
    "test:targets:docker": "bash ../../test/api/integration/target-validation.docker.sh",
    "test:authorization:docker": "bash ../../test/api/integration/legal-authorization.docker.sh",
    "test:external:docker": "bash ../../test/api/integration/legal-external-acceptance.docker.sh",
    "test:e2e:isolated": "node ../../test/api/e2e/run-isolated.cjs",
    "migration:run:prod": "node node_modules/typeorm/cli.js migration:run -d dist/data-source.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@hemia/auth": "1.0.8",
    "@hemia/event-bus": "0.0.3",
    "@hemia/secrets": "^0.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "markdown-it": "^14.3.0",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "../..",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "<rootDir>/apps/api/node_modules/ts-jest",
        {
          "tsconfig": "<rootDir>/test/api/tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "apps/api/src/**/*.ts"
    ],
    "coverageDirectory": "<rootDir>/apps/api/coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test/api/unit"
    ],
    "modulePaths": [
      "<rootDir>/apps/api/node_modules"
    ]
  }
}
